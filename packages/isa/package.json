{
  "name": "@match-kit/isa",
  "version": "0.0.0",
  "description": "Instruction sets for decompilation tools: decode, print as GNU as text that assembles back to the same bytes, parse and encode. ARMv4T (ARM and Thumb) so far",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macabeus/match-kit.git",
    "directory": "packages/isa"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./armv4t": {
      "types": "./dist/armv4t.d.ts",
      "default": "./dist/armv4t.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "pnpm build"
  }
}
