{
  "name": "@match-kit/compiler",
  "version": "0.1.0",
  "description": "Run a project's compile command template: one candidate source in, one object out, every failure named",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macabeus/match-kit.git",
    "directory": "packages/compiler"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "pnpm build"
  }
}
