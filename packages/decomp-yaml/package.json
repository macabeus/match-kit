{
  "name": "@match-kit/decomp-yaml",
  "version": "0.0.0",
  "description": "Read a project's decomp.yaml (the decomp_settings format), checked against the spec, and each tool's block with a Standard Schema",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macabeus/match-kit.git",
    "directory": "packages/decomp-yaml"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src",
    "schema.json",
    "SPEC.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "default": "./dist/files.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
