{
  "name": "match-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-deps": "depcruise --config .dependency-cruiser.cjs 'packages/*/src/**/*.ts'",
    "test": "vitest run --project node",
    "test:bun": "bun --bun vitest run --project node",
    "test:browser": "vitest run --project browser",
    "changeset": "changeset",
    "release:version": "changeset version && node packages/decomp-yaml/scripts/sync-schema-version.mjs",
    "check-package": "sh scripts/check-package.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/browser-playwright": "^5.0.2",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
